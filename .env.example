# Port
PORT=8000

# Image
CHATMOCK_IMAGE=storagetime/chatmock:latest

# Auth dir
CHATGPT_LOCAL_HOME=/data

# show request/stream logs
VERBOSE=false

# OAuth client id (modify only if you know what you're doing)
# CHATGPT_LOCAL_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# Reasoning controls
CHATGPT_LOCAL_REASONING_EFFORT=medium       # none|minimal|low|medium|high|xhigh
CHATGPT_LOCAL_REASONING_SUMMARY=auto        # auto|concise|detailed|none
CHATGPT_LOCAL_REASONING_COMPAT=think-tags   # legacy|o3|think-tags|current
CHATGPT_LOCAL_EXPOSE_REASONING_MODELS=false

# Enable default web search tool
CHATGPT_LOCAL_ENABLE_WEB_SEARCH=false

# Force a specific model name
# CHATGPT_LOCAL_DEBUG_MODEL=gpt-5.4

# External OpenAI-compatible providers
# Enable a provider by setting its API key or CHATMOCK_ENABLE_* flag.

# Z.AI GLM Coding Plan
# CHATMOCK_ZAI_API_KEY=
# CHATMOCK_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# CHATMOCK_ZAI_MODELS=glm-5.2,glm-5.1,glm-5,glm-5-turbo,glm-4.7,glm-4.5-air

# Xiaomi MiMo Token Plan
# CHATMOCK_XIAOMI_API_KEY=
# CHATMOCK_XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# CHATMOCK_XIAOMI_MODELS=mimo-v2.5-pro,mimo-v2.5

# DeepSeek API
# CHATMOCK_DEEPSEEK_API_KEY=
# CHATMOCK_DEEPSEEK_BASE_URL=https://api.deepseek.com
# CHATMOCK_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-chat,deepseek-reasoner

# Local OpenAI-compatible providers
# CHATMOCK_ENABLE_OLLAMA=false
# CHATMOCK_OLLAMA_BASE_URL=http://localhost:11434/v1
# CHATMOCK_OLLAMA_MODELS=llama3.2,qwen3-coder
# CHATMOCK_ENABLE_LM_STUDIO=false
# CHATMOCK_LM_STUDIO_BASE_URL=http://localhost:1234/v1
# CHATMOCK_LM_STUDIO_MODELS=local-model

# Custom provider JSON:
# CHATMOCK_PROVIDERS_JSON=[{"name":"my","base_url":"https://example.com/v1","api_key_env":"MY_API_KEY","models":["my-model"]}]
